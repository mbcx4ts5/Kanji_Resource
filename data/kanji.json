    "vocabulary": ["本・ほん", "日本・にほん", "本日・ほんじつ", "古本・ふるほん"]
  },
  {
    "id": "K-0030",
    "character": "計",
    "keyword": "Measure",
    "order": 30,
    "elements": ["E-018", "E-006"],
    "grade": 2,
    "description": "This kanji always reminds me of one of those complicated architectural blueprints with lots of annotating 'words', 'crosses' indicating the important parts of the plan, and of course the all important measurements.",
    "same_element": null,
    "vocabulary": ["計る・はかる"]
  },
  {
    "id": "K-0031",
    "character": "語",
    "keyword": "Language",
    "order": 31,
    "elements": ["E-018", "E-002", "E-007"],
    "grade": 2,
    "description": "'Say five mouths' clearly refers to the five senses used to fully communicate across a language barrier. Of course we must use our mouths to say words, but we must also use our other senses to fully appreciate the language and culture.",
    "same_element": null,
    "vocabulary": ["語・ご", "言語・げんご", "日本語・にほんご", "語る・かたる"]
  },
  {
    "id": "K-0032",
    "character": "員",
    "keyword": "Employee",
    "order": 32,
    "elements": ["E-007", "E-016"],
    "grade": 3,
    "description": "A 'mouth' above a 'shellfish' could represent someone eating lots of seafood, but here, the mouth is in fact eating all the 'money' generated by the company they work for, presumably to the dismay of the big bosses.",
    "same_element": null,
    "vocabulary": ["員・いん"]
  },
  {
